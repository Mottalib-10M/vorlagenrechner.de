---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../LegalIdentity.astro';
import { AUTHOR_NAME, CONTACT_EMAIL, LAST_UPDATED, SITE_NAMES } from '../../data/site-config';
import { route, type Locale } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
import { helpers } from '../../lib/helpers';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang); const T = H.T;
const name = SITE_NAMES[lang];
const crumb = T('Kontakt', 'Contact');
const description = T(
  `Schreiben Sie dem Herausgeber von ${name}: einen Fehler in einer Frist melden, auf eine geänderte Vorschrift hinweisen, einen Satz infrage stellen oder den Rechner einbinden.`,
  `Write to the publisher of ${name}: report a wrong deadline, point to a changed provision, question a sentence in a template or embed the calculator on your own site.`);
const mail = `mailto:${CONTACT_EMAIL}`;
---
<PageLayout title={`${crumb} – ${name}`} description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: crumb, description, path: route('contact', lang), lang })]} breadcrumbs={[{ label: crumb }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>{crumb}</h1>
    {lang === 'de' && <>
      <p>Eine Adresse, regelmäßig gelesen: <a href={mail}>{CONTACT_EMAIL}</a>. Kein Telefon, kein Rückruf, kein Verkauf.</p>
      <h2>Einen Fehler melden</h2><p>Nennen Sie die Vorlage, Ihre Eingaben und das Ergebnis, das Sie erwartet hätten, möglichst mit der Vorschrift. Ein bestätigter Fehler wird korrigiert und als Test aufgenommen, wie es die <a href={route('editorial', lang)}>redaktionellen Grundsätze</a> beschreiben.</p>
      <h2>Was wir nicht können</h2><p>Wir beraten nicht im Einzelfall, prüfen keine Verträge und vertreten niemanden gegenüber Vermietern, Arbeitgebern oder Anbietern (siehe <a href={route('method', lang)}>Methode</a>).</p>
      <h2>Den Rechner einbinden</h2><p>Betriebsräte, Beratungsstellen und Redaktionen können den Kündigungsfrist-Rechner kostenlos einbinden: der Code steht auf der Seite <a href={route('widget', lang)}>Fristenrechner einbinden</a>.</p>
      <h2>Herausgeber</h2>
    </>}
    {lang === 'en' && <>
      <p>One address, read regularly: <a href={mail}>{CONTACT_EMAIL}</a>. No phone, no call-backs, nothing for sale.</p>
      <h2>Report an error</h2><p>Name the template, your inputs and the result you expected, ideally with the provision. A confirmed error is corrected and becomes a test, as the <a href={route('editorial', lang)}>editorial policy</a> sets out.</p>
      <h2>What we cannot do</h2><p>We give no individual advice, review no contracts and represent nobody towards landlords, employers or providers (see the <a href={route('method', lang)}>method</a>).</p>
      <h2>Embed the calculator</h2><p>Works councils, advice centres and newsrooms can embed the notice period calculator for free; the code is on the <a href={route('widget', lang)}>Embed the calculator</a> page.</p>
      <h2>Publisher</h2>
    </>}
    <LegalIdentity lang={lang} />
    <p>{T(`${AUTHOR_NAME} ist für den Inhalt von ${name} verantwortlich; die vollständigen Angaben stehen im`, `${AUTHOR_NAME} is responsible for the content of ${name}; full details are in the`)} <a href={route('terms', lang)}>{T('Impressum', 'legal notice')}</a>. {T('Seite geprüft am', 'Page reviewed on')} {H.date(LAST_UPDATED)}.</p>
  </div>
</PageLayout>
