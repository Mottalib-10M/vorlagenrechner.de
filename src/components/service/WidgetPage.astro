---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route, type Locale } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { helpers } from '../../lib/helpers';
import { EMBED } from '../../lib/embed';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang); const T = H.T;
const e = EMBED[lang];
const code = `<iframe src="${SITE_URL}/embed/${e.slug}/" title="${e.title}" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const title = T('Kündigungsfrist-Rechner auf Ihrer Seite einbinden', 'Embed the German notice period calculator on your site');
const description = T(
  'Binden Sie den Rechner für Kündigungsfristen im Arbeitsverhältnis nach § 622 BGB kostenlos als iframe ein: ein Code zum Kopieren, ohne Anmeldung und ohne Kosten.',
  'Embed the calculator for German employment notice periods under section 622 BGB free of charge as an iframe: one code to copy, no sign-up and no fee for your visitors.');
const crumb = T('Fristenrechner einbinden', 'Embed the calculator');
---
<PageLayout title={title} description={description} lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: T('Startseite', 'Home'), path: route('home', lang) }, { name: crumb, path: route('widget', lang) }])]} breadcrumbs={[{ label: crumb }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{crumb}</h1>
    <p class="mt-3 text-lg text-navy-700">{T('Ein Code zum Kopieren, ohne Anmeldung und ohne Kosten. Betriebsräte, Beratungsstellen und Redaktionen bauen ihn in einer Minute ein.', 'One code to copy, no sign-up and no fee. Works councils, advice centres and newsrooms set it up in a minute.')}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>{T('Bedingungen: der Link unter dem Rechner und der Hinweis „unabhängige Seite, keine Rechtsberatung“ bleiben sichtbar, der Inhalt wird nicht verändert, er wird ohne Gewähr bereitgestellt.', 'Terms: the link below the calculator and the notice “independent site, no legal advice” stay visible, the content is not altered, and it is provided without warranty.')}</p>
    <p>{T('Andere Sprache:', 'Other language:')} {Object.values(EMBED).filter((x) => x.slug !== e.slug).map((x) => <code>{`${SITE_URL}/embed/${x.slug}/`}</code>)}</p>
    <p>{T('Was Ihre Besucher eingeben, bleibt in ihrem Browser. Fragen über die', 'What your visitors enter stays in their browser. Questions via the')} <a href={route('contact', lang)}>{T('Kontaktseite', 'contact page')}</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${e.slug}/`} title={e.title} width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
